# 复制为 .env 后按需修改：cp .env.sample .env

# 公开入口（不需要登录）：
#   tls   直接对外（默认）。Caddy 监听 80、443，为五个子域名自动申请证书。
#   vhost 放在 CDN 或反向代理之后。Caddy 只监听一个明文端口 HTTP_PORT，按访问的域名区分上游，
#         回源时要保留 Host；由前面负责 TLS。
#   http  放在 CDN 或反向代理之后，但回源不保留 Host 时用。每个上游一个明文端口 5001–5005。
#   off   不开公开入口，只用下面需要登录的入口。
MODE=tls

# tls、vhost 模式：你的域名。五个子域名 docker、gcr、ghcr、k8s、quay.<DOMAIN>。
# tls 模式要把它们解析到本机，并让 80、443 端口能从公网访问（HTTP-01 / TLS-ALPN-01 验证）。
DOMAIN=example.com

# vhost 模式的明文端口，公开入口和需要登录的入口共用。
# HTTP_PORT=8080

# 监听地址。留空表示所有地址；反向代理与本服务在同一台机器上时可设为 127.0.0.1。
BIND=

# 信任这些地址发来的 X-Forwarded-For，用于在访问日志中记录真实客户端 IP。
# 放在 CDN 之后时改为 CDN 的回源地址段（空格分隔）。
TRUSTED_PROXIES=private_ranges

# http 模式的端口，默认 5001–5005 依次对应 Docker Hub、gcr.io、ghcr.io、registry.k8s.io、quay.io。
# 和旧版部署在同一台机器上并行测试时，可以改成别的端口。
# PORT_DOCKER=5001
# PORT_GCR=5002
# PORT_GHCR=5003
# PORT_K8S=5004
# PORT_QUAY=5005

# zot 在本机回环地址上的端口，只给 Caddy 用，不要对外开放。
# ZOT_PORT=5100

# 镜像缓存的目录，默认是部署目录下的 ./data/zot。缓存只按「7 天内没人拉过」清理、不按容量淘汰（见 README 的「限制」），
# 系统盘小的机器请放到数据盘，例如 /data/storage/registry-mirrors/zot。
# ZOT_DATA=./data/zot

# 需要登录的入口（Basic Auth），和公开入口共用同一个 zot 缓存。用户写在 caddy/users.caddy，
# 见 caddy/users.caddy.sample。客户端先 docker login，再照常拉取。
#   off  不开（默认）
#   tls   五个子域名 docker、gcr、ghcr、k8s、quay.<AUTH_DOMAIN>，自动申请证书（AUTH_DOMAIN 不能和 DOMAIN 相同）
#   vhost 和公开入口共用 HTTP_PORT，按 *.<AUTH_DOMAIN> 区分，由前面负责 TLS
#   http  明文端口 15001–15005（依次对应 Docker Hub、gcr.io、ghcr.io、registry.k8s.io、quay.io），由前面负责 TLS
AUTH_MODE=off
# AUTH_DOMAIN=example.net
# AUTH_PORT_DOCKER=15001
# AUTH_PORT_GCR=15002
# AUTH_PORT_GHCR=15003
# AUTH_PORT_K8S=15004
# AUTH_PORT_QUAY=15005
