# 直连模式（MODE=tls，默认）：Caddy 直接对外提供五个域名，并自动申请、续期证书。
# 用 HTTP-01 / TLS-ALPN-01 验证，需要 80、443 端口能从公网访问；每个域名单独一张证书，不用通配符。

docker.{$DOMAIN} {
	import access_log
	import mirror docker.io
}

gcr.{$DOMAIN} {
	import access_log
	import mirror gcr.io
}

ghcr.{$DOMAIN} {
	import access_log
	import mirror ghcr.io
}

k8s.{$DOMAIN} {
	import access_log
	import mirror registry.k8s.io
}

quay.{$DOMAIN} {
	import access_log
	import mirror quay.io
}
